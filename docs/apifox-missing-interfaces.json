{
  "openapi": "3.0.0",
  "info": {
    "title": "陪诊系统API - 补充缺失接口",
    "version": "1.0.0",
    "description": "从用户导出文件中识别出的9个缺失接口"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API基础路径"
    }
  ],
  "security": [
    {
      "tokenAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "token",
        "description": "JWT令牌认证"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "统一响应格式",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应码：200=成功，400=请求错误，401=未授权，500=服务器错误",
            "example": 200
          },
          "msg": {
            "type": "string",
            "description": "响应消息",
            "example": "操作成功"
          },
          "data": {
            "description": "响应数据"
          }
        },
        "required": ["code"]
      },
      "UserProfile": {
        "type": "object",
        "description": "用户信息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "用户ID"
          },
          "nickname": {
            "type": "string",
            "description": "昵称"
          },
          "avatar": {
            "type": "string",
            "description": "头像URL"
          },
          "phone": {
            "type": "string",
            "description": "手机号"
          },
          "balance": {
            "type": "number",
            "format": "double",
            "description": "账户余额"
          }
        },
        "required": ["id", "nickname", "phone"]
      },
      "Patient": {
        "type": "object",
        "description": "就诊人信息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "就诊人ID"
          },
          "name": {
            "type": "string",
            "description": "姓名"
          },
          "phone": {
            "type": "string",
            "description": "联系电话"
          },
          "address": {
            "type": "string",
            "description": "地址"
          },
          "relationship": {
            "type": "string",
            "description": "关系"
          },
          "default": {
            "type": "boolean",
            "description": "是否为默认就诊人"
          }
        },
        "required": ["id", "name", "phone", "relationship"]
      },
      "OrderComment": {
        "type": "object",
        "description": "订单评价",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "订单ID"
          },
          "score": {
            "type": "integer",
            "description": "评分，1-5分",
            "minimum": 1,
            "maximum": 5
          },
          "content": {
            "type": "string",
            "description": "评价内容"
          },
          "images": {
            "type": "array",
            "description": "评价图片",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["orderId", "score", "content"]
      },
      "MessageConversation": {
        "type": "object",
        "description": "消息会话",
        "properties": {
          "id": {
            "type": "string",
            "description": "会话ID"
          },
          "type": {
            "type": "string",
            "description": "类型：service/companion/system"
          },
          "name": {
            "type": "string",
            "description": "名称"
          },
          "time": {
            "type": "string",
            "description": "时间"
          },
          "preview": {
            "type": "string",
            "description": "最后一条消息预览"
          },
          "avatar": {
            "type": "string",
            "description": "头像"
          }
        },
        "required": ["id", "type", "name"]
      },
      "ChatMessage": {
        "type": "object",
        "description": "聊天消息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "消息ID"
          },
          "text": {
            "type": "string",
            "description": "消息内容"
          },
          "isMe": {
            "type": "boolean",
            "description": "是否是自己发送的"
          },
          "time": {
            "type": "string",
            "description": "时间"
          },
          "type": {
            "type": "string",
            "description": "消息类型"
          }
        },
        "required": ["id", "text", "isMe", "time"]
      }
    }
  },
  "paths": {
    "/user/profile": {
      "put": {
        "tags": ["用户模块"],
        "summary": "更新用户信息",
        "description": "更新用户个人信息，支持更新昵称、头像等字段",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "description": "昵称",
                    "example": "张三"
                  },
                  "avatar": {
                    "type": "string",
                    "description": "头像URL",
                    "example": "https://example.com/avatar.jpg"
                  }
                },
                "required": ["nickname"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserProfile"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "msg": "更新成功",
                  "data": {
                    "id": 1,
                    "nickname": "张三",
                    "avatar": "https://example.com/avatar.jpg",
                    "phone": "13800138000",
                    "balance": 100.50
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求错误",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "昵称不能为空",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 401,
                  "msg": "登录已过期，请重新登录",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/user/patients": {
      "post": {
        "tags": ["就诊人模块"],
        "summary": "添加就诊人",
        "description": "添加新的就诊人信息",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "姓名",
                    "example": "李四"
                  },
                  "phone": {
                    "type": "string",
                    "description": "联系电话",
                    "example": "13900139000"
                  },
                  "address": {
                    "type": "string",
                    "description": "地址",
                    "example": "北京市朝阳区"
                  },
                  "relationship": {
                    "type": "string",
                    "description": "关系",
                    "example": "父亲"
                  },
                  "default": {
                    "type": "boolean",
                    "description": "是否设为默认就诊人",
                    "example": false
                  }
                },
                "required": ["name", "phone", "relationship"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "添加成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Patient"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "msg": "添加成功",
                  "data": {
                    "id": 5,
                    "name": "李四",
                    "phone": "13900139000",
                    "address": "北京市朝阳区",
                    "relationship": "父亲",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/patients/{id}": {
      "put": {
        "tags": ["就诊人模块"],
        "summary": "更新就诊人信息",
        "description": "更新指定就诊人的信息",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "就诊人ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "姓名"
                  },
                  "phone": {
                    "type": "string",
                    "description": "联系电话"
                  },
                  "address": {
                    "type": "string",
                    "description": "地址"
                  },
                  "relationship": {
                    "type": "string",
                    "description": "关系"
                  }
                },
                "required": ["name", "phone", "relationship"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Patient"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "就诊人不存在",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "就诊人不存在",
                  "data": null
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["就诊人模块"],
        "summary": "删除就诊人",
        "description": "删除指定的就诊人信息",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "就诊人ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 200,
                  "msg": "删除成功",
                  "data": null
                }
              }
            }
          },
          "400": {
            "description": "删除失败",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "不能删除默认就诊人",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/user/patients/{id}/default": {
      "put": {
        "tags": ["就诊人模块"],
        "summary": "设置默认就诊人",
        "description": "将指定就诊人设为默认就诊人",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "就诊人ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "设置成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 200,
                  "msg": "设置成功",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/user/orders/{id}/comment": {
      "post": {
        "tags": ["订单模块"],
        "summary": "提交订单评价",
        "description": "对已完成的订单进行评价",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "订单ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderComment"
              },
              "example": {
                "score": 5,
                "content": "服务非常好，陪诊师很专业！",
                "images": ["https://example.com/image1.jpg", "https://example.com/image2.jpg"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "评价成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 200,
                  "msg": "评价成功",
                  "data": null
                }
              }
            }
          },
          "400": {
            "description": "评价失败",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "该订单尚未完成，暂不可评价",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/user/messages/{id}": {
      "delete": {
        "tags": ["消息模块"],
        "summary": "删除消息会话",
        "description": "删除指定的消息会话",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "会话ID（service/companion/system）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 200,
                  "msg": "删除成功",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "会话不存在",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "会话不存在",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/user/chats/{type}": {
      "delete": {
        "tags": ["聊天模块"],
        "summary": "删除聊天会话",
        "description": "删除与特定对象的聊天会话及其所有消息",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "description": "聊天对象类型（service=客服，companion_{id}=陪诊师）",
            "required": true,
            "schema": {
              "type": "string",
              "example": "service"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 200,
                  "msg": "删除成功",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "聊天会话不存在",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"},
                "example": {
                  "code": 400,
                  "msg": "聊天会话不存在",
                  "data": null
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["聊天模块"],
        "summary": "获取聊天消息列表",
        "description": "获取与特定对象的所有聊天消息",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "description": "聊天对象类型（service=客服，companion_{id}=陪诊师）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/ChatMessage"}
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": [
                    {
                      "id": 1,
                      "text": "您好，有什么可以帮助您的？",
                      "isMe": false,
                      "time": "10:30",
                      "type": "service"
                    },
                    {
                      "id": 2,
                      "text": "我想咨询陪诊服务",
                      "isMe": true,
                      "time": "10:31",
                      "type": "service"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "用户模块",
      "description": "用户信息管理接口"
    },
    {
      "name": "就诊人模块",
      "description": "就诊人信息管理接口"
    },
    {
      "name": "订单模块",
      "description": "订单评价接口"
    },
    {
      "name": "消息模块",
      "description": "消息会话管理接口"
    },
    {
      "name": "聊天模块",
      "description": "聊天消息管理接口"
    }
  ]
}
