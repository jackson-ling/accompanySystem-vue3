{
  "openapi": "3.0.0",
  "info": {
    "title": "陪诊系统API - 完整接口",
    "version": "2.1.0",
    "description": "陪诊系统完整API接口文档 - 包含所有新增模块"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API基础路径"
    }
  ],
  "security": [
    {
      "tokenAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "token",
        "description": "JWT令牌认证"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "统一响应格式",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应码：200=成功，400=请求错误，401=未授权，500=服务器错误",
            "example": 200
          },
          "msg": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          },
          "data": {
            "description": "响应数据"
          }
        },
        "required": ["code"]
      },
      "PaginatedResult": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "总数"
          },
          "list": {
            "type": "array",
            "description": "数据列表"
          },
          "page": {
            "type": "integer",
            "description": "当前页码"
          },
          "size": {
            "type": "integer",
            "description": "每页数量"
          }
        },
        "required": ["total", "list"]
      },
      "DictItem": {
        "type": "object",
        "description": "字典项",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID"
          },
          "name": {
            "type": "string",
            "description": "名称"
          },
          "value": {
            "type": "string",
            "description": "值"
          }
        },
        "required": ["id", "name"]
      },
      "HospitalItem": {
        "type": "object",
        "description": "医院信息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "医院ID"
          },
          "name": {
            "type": "string",
            "description": "医院名称"
          },
          "address": {
            "type": "string",
            "description": "医院地址"
          },
          "level": {
            "type": "string",
            "description": "医院等级"
          }
        },
        "required": ["id", "name"]
      },
      "DepartmentItem": {
        "type": "object",
        "description": "科室信息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "科室ID"
          },
          "name": {
            "type": "string",
            "description": "科室名称"
          },
          "hospitalId": {
            "type": "integer",
            "description": "所属医院ID"
          }
        },
        "required": ["id", "name"]
      },
      "FavoriteItem": {
        "type": "object",
        "description": "收藏项",
        "properties": {
          "id": {
            "type": "integer",
            "description": "收藏记录ID"
          },
          "type": {
            "type": "string",
            "description": "收藏类型：companion/service",
            "enum": ["companion", "service"]
          },
          "itemId": {
            "type": "integer",
            "description": "收藏项ID"
          },
          "name": {
            "type": "string",
            "description": "名称"
          },
          "avatar": {
            "type": "string",
            "description": "头像URL"
          },
          "description": {
            "type": "string",
            "description": "描述"
          },
          "time": {
            "type": "string",
            "description": "收藏时间"
          }
        },
        "required": ["id", "type", "itemId", "name"]
      },
      "UploadResult": {
        "type": "object",
        "description": "上传结果",
        "properties": {
          "url": {
            "type": "string",
            "description": "文件URL"
          },
          "filename": {
            "type": "string",
            "description": "文件名"
          }
        },
        "required": ["url"]
      },
      "ConsumptionRecord": {
        "type": "object",
        "description": "消费记录",
        "properties": {
          "id": {
            "type": "integer",
            "description": "记录ID"
          },
          "type": {
            "type": "string",
            "description": "类型"
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "金额"
          },
          "balance": {
            "type": "number",
            "format": "double",
            "description": "余额"
          },
          "time": {
            "type": "string",
            "description": "时间"
          },
          "orderId": {
            "type": "string",
            "description": "订单ID（可选）"
          }
        },
        "required": ["id", "type", "amount", "balance", "time"]
      },
      "TimeSlot": {
        "type": "object",
        "description": "时间段",
        "properties": {
          "time": {
            "type": "string",
            "description": "时间，格式 HH:mm",
            "example": "09:00"
          },
          "status": {
            "type": "string",
            "description": "状态：available=可预约，booked=已预约",
            "enum": ["available", "booked"]
          }
        },
        "required": ["time", "status"]
      },
      "CompanionProfile": {
        "type": "object",
        "description": "陪诊师个人信息",
        "properties": {
          "id": {
            "type": "integer",
            "description": "陪诊师ID"
          },
          "name": {
            "type": "string",
            "description": "姓名"
          },
          "avatar": {
            "type": "string",
            "description": "头像URL"
          },
          "age": {
            "type": "integer",
            "description": "年龄"
          },
          "gender": {
            "type": "string",
            "description": "性别：male/female"
          },
          "experience": {
            "type": "string",
            "description": "从业年限，如：从业3年"
          },
          "phone": {
            "type": "string",
            "description": "联系电话"
          }
        },
        "required": ["id", "name"]
      },
      "RechargeConfig": {
        "type": "object",
        "description": "充值配置",
        "properties": {
          "amounts": {
            "type": "array",
            "description": "推荐充值金额数组",
            "items": {
              "type": "integer"
            },
            "example": [50, 100, 200, 500, 1000]
          },
          "methods": {
            "type": "array",
            "description": "支付方式列表",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "description": "支付方式值"
                },
                "name": {
                  "type": "string",
                  "description": "显示名称"
                },
                "icon": {
                  "type": "string",
                  "description": "图标URL"
                }
              },
              "required": ["value", "name"]
            }
          }
        },
        "required": ["amounts", "methods"]
      },
      "Order": {
        "type": "object",
        "description": "订单信息",
        "properties": {
          "id": {
            "type": "string",
            "description": "订单ID"
          },
          "status": {
            "type": "integer",
            "description": "订单状态"
          },
          "serviceName": {
            "type": "string",
            "description": "服务名称"
          },
          "appointmentTime": {
            "type": "string",
            "description": "预约时间"
          }
        },
        "required": ["id", "status"]
      }
    }
  },
  "paths": {
    "/dict/service-types": {
      "get": {
        "tags": ["字典模块"],
        "summary": "获取服务类型列表",
        "description": "获取所有服务类型列表",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/DictItem"},
                          "example": [
                            {"id": 1, "name": "门诊陪诊", "value": "outpatient"},
                            {"id": 2, "name": "住院陪护", "value": "inpatient"}
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/dict/hospitals": {
      "get": {
        "tags": ["字典模块"],
        "summary": "获取医院列表",
        "description": "获取医院列表，支持关键词搜索",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "搜索关键词",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/HospitalItem"},
                          "example": [
                            {
                              "id": 1,
                              "name": "北京协和医院",
                              "address": "北京市东城区帅府园1号",
                              "level": "三甲"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/dict/departments": {
      "get": {
        "tags": ["字典模块"],
        "summary": "获取科室列表",
        "description": "获取科室列表，可按医院筛选",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "hospitalId",
            "in": "query",
            "description": "医院ID（筛选特定医院的科室）",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/DepartmentItem"},
                          "example": [
                            {"id": 1, "name": "心内科", "hospitalId": 1},
                            {"id": 2, "name": "神经内科", "hospitalId": 1}
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/favorites": {
      "get": {
        "tags": ["收藏模块"],
        "summary": "获取收藏列表",
        "description": "获取用户的收藏列表，可按类型筛选",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "收藏类型：companion=陪诊师，service=服务",
            "schema": {
              "type": "string",
              "enum": ["companion", "service"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/FavoriteItem"}
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["收藏模块"],
        "summary": "添加收藏",
        "description": "添加陪诊师或服务到收藏",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "收藏类型",
                    "enum": ["companion", "service"]
                  },
                  "itemId": {
                    "type": "integer",
                    "description": "收藏项ID"
                  }
                },
                "required": ["type", "itemId"],
                "example": {
                  "type": "companion",
                  "itemId": 101
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/user/favorites/{id}": {
      "delete": {
        "tags": ["收藏模块"],
        "summary": "取消收藏",
        "description": "根据收藏记录ID删除收藏",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "收藏记录ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/upload/image": {
      "post": {
        "tags": ["上传模块"],
        "summary": "上传图片",
        "description": "上传图片文件，支持 jpg、jpeg、png、gif 格式，最大5MB",
        "security": [{"tokenAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "图片文件"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UploadResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/consumption": {
      "get": {
        "tags": ["钱包模块"],
        "summary": "获取消费记录",
        "description": "获取用户的消费记录列表，支持分页",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "每页数量",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PaginatedResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/transactions": {
      "get": {
        "tags": ["钱包模块"],
        "summary": "获取交易记录",
        "description": "获取用户的所有交易记录（包括充值和消费），支持分页",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "每页数量",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PaginatedResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/recharge/config": {
      "get": {
        "tags": ["充值模块"],
        "summary": "获取充值配置",
        "description": "获取充值配置信息，包括推荐充值金额和支付方式",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RechargeConfig"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/companion/profile": {
      "get": {
        "tags": ["陪诊师工作台"],
        "summary": "获取陪诊师个人信息",
        "description": "获取当前登录陪诊师的个人信息",
        "security": [{"tokenAuth": []}],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CompanionProfile"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/companion/orders/{orderId}/accept": {
      "put": {
        "tags": ["陪诊师工作台"],
        "summary": "陪诊师接单",
        "description": "陪诊师接受订单，将订单状态改为待服务",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "订单ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "接单成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Order"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/companion/orders/{orderId}/reject": {
      "put": {
        "tags": ["陪诊师工作台"],
        "summary": "陪诊师拒单",
        "description": "陪诊师拒绝订单，可选择拒单原因",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "订单ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "拒单原因（可选）"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "拒单成功",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          }
        }
      }
    },
    "/services/{serviceId}/available-times": {
      "get": {
        "tags": ["服务模块"],
        "summary": "获取可预约时间段",
        "description": "获取指定服务在指定日期的可预约时间段列表",
        "security": [{"tokenAuth": []}],
        "parameters": [
          {
            "name": "serviceId",
            "in": "path",
            "description": "服务ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "日期，格式：YYYY-MM-DD",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2024-03-21"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {"$ref": "#/components/schemas/TimeSlot"},
                          "example": [
                            {"time": "09:00", "status": "available"},
                            {"time": "09:30", "status": "booked"},
                            {"time": "10:00", "status": "available"}
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "字典模块",
      "description": "服务类型、医院、科室等字典数据接口"
    },
    {
      "name": "收藏模块",
      "description": "陪诊师和服务收藏管理接口"
    },
    {
      "name": "上传模块",
      "description": "图片文件上传接口"
    },
